function actionsForGP(g) {
  if(g.status==='pending') return `<div class="act-btns"><button class="act-btn" onclick="approveGP('${g.id}',event)" title="Approve">✓</button><button class="act-btn danger" onclick="denyGP('${g.id}',event)" title="Deny">✕</button></div>`;
  if(g.status==='approved') return `<div class="act-btns"><button class="act-btn" onclick="returnGP('${g.id}',event)" title="Mark Returned">↩</button><button class="act-btn" onclick="viewGP('${g.id}',event)" title="View">👁</button></div>`;
  if(g.status==='denied') return `<div class="act-btns"><button class="act-btn" onclick="approveGP('${g.id}',event)" title="Re-approve">↺</button></div>`;
  return `<div class="act-btns"><button class="act-btn" onclick="viewGP('${g.id}',event)" title="View">👁</button></div>`;
}

function approveGP(id, e) { e&&e.stopPropagation(); const g=DB.gatePasses.find(x=>x.id===id); if(g){g.status='approved'; DB.smsCounter++; DB.notifications.unshift({type:'green',text:`Parent SMS sent for ${g.student} (gate pass approved)`,meta:'Just now · Auto-triggered',read:false}); showToast(`Gate pass approved & SMS sent to ${g.student}'s parent`,'success'); renderDashboard(); renderGatePasses&&renderGatePasses(); }}
function denyGP(id, e) { e&&e.stopPropagation(); const g=DB.gatePasses.find(x=>x.id===id); if(g){g.status='denied'; showToast(`Gate pass denied for ${g.student}`,'error'); renderDashboard(); }}
function returnGP(id, e) { e&&e.stopPropagation(); const g=DB.gatePasses.find(x=>x.id===id); if(g){g.status='returned'; DB.smsCounter++; DB.notifications.unshift({type:'green',text:`${g.student} returned on time`,meta:'Just now · System',read:false}); showToast(`${g.student} marked as returned`,'success'); renderDashboard(); }}
function viewGP(id, e) { e&&e.stopPropagation(); const g=DB.gatePasses.find(x=>x.id===id); openModal('viewgp',g); }

