<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>HostelSync — Operations Platform</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Syne:wght@400;600;700;800&display=swap" rel="stylesheet"/>
<style>
:root{
  --bg:#0a0c0f;--surface:#111418;--surface2:#181c22;--surface3:#1e232b;
  --border:#232830;--border2:#2e3540;
  --accent:#00e5a0;--accent-dim:rgba(0,229,160,0.12);--accent-border:rgba(0,229,160,0.25);
  --red:#ff6b35;--red-dim:rgba(255,107,53,0.12);--red-border:rgba(255,107,53,0.25);
  --blue:#4d9fff;--blue-dim:rgba(77,159,255,0.12);--blue-border:rgba(77,159,255,0.25);
  --yellow:#ffd93d;--yellow-dim:rgba(255,217,61,0.12);--yellow-border:rgba(255,217,61,0.3);
  --text:#e8edf3;--text-muted:#6b7785;--text-dim:#3d4855;
  --tag-bg:#0d2d1e;
  --radius:12px;--radius-sm:7px;
  --accent2:#ff6b35;--accent3:#4d9fff;--warn:#ffd93d;
}
*{margin:0;padding:0;box-sizing:border-box;}
body{background:var(--bg);color:var(--text);font-family:'Syne',sans-serif;min-height:100vh;overflow-x:hidden;}
body::before{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(0,229,160,0.025) 1px,transparent 1px),linear-gradient(90deg,rgba(0,229,160,0.025) 1px,transparent 1px);background-size:48px 48px;pointer-events:none;z-index:0;}
body::after{content:'';position:fixed;top:-200px;left:-200px;width:600px;height:600px;background:radial-gradient(circle,rgba(0,229,160,0.06) 0%,transparent 70%);pointer-events:none;z-index:0;animation:blob 10s ease-in-out infinite;}
@keyframes blob{0%,100%{transform:translate(0,0);}50%{transform:translate(100px,80px);}}

/* SHELL */
.shell{position:relative;z-index:1;display:grid;grid-template-columns:220px 1fr;grid-template-rows:60px 1fr;min-height:100vh;}

/* TOPBAR */
.topbar{grid-column:1/-1;display:flex;align-items:center;justify-content:space-between;padding:0 28px;height:60px;border-bottom:1px solid var(--border);background:rgba(10,12,15,0.95);backdrop-filter:blur(12px);position:sticky;top:0;z-index:200;}
.logo{display:flex;align-items:center;gap:10px;}
.logo-mark{width:32px;height:32px;background:var(--accent);border-radius:5px;display:grid;place-items:center;font-family:'Space Mono',monospace;font-size:11px;font-weight:700;color:#000;letter-spacing:-1px;}
.logo-text{font-size:17px;font-weight:800;letter-spacing:-0.3px;}
.logo-text span{color:var(--accent);}
.tag{font-family:'Space Mono',monospace;font-size:10px;background:var(--tag-bg);border:1px solid var(--accent-border);color:var(--accent);padding:2px 8px;border-radius:99px;letter-spacing:1px;}
.topbar-right{display:flex;align-items:center;gap:12px;}
.tb-search{background:var(--surface2);border:1px solid var(--border);border-radius:var(--radius-sm);padding:6px 12px;color:var(--text-muted);font-family:'Space Mono',monospace;font-size:11px;width:180px;outline:none;transition:border-color 0.2s;}
.tb-search:focus{border-color:var(--accent);color:var(--text);}
.tb-btn{background:none;border:1px solid var(--border);color:var(--text-muted);border-radius:var(--radius-sm);padding:6px 14px;font-family:'Space Mono',monospace;font-size:11px;cursor:pointer;transition:all 0.2s;letter-spacing:0.5px;}
.tb-btn:hover{border-color:var(--accent);color:var(--accent);}
.tb-btn.primary{background:var(--accent);color:#000;border-color:var(--accent);font-weight:700;}
.tb-btn.primary:hover{opacity:0.85;}
.notif-bell{position:relative;cursor:pointer;width:34px;height:34px;display:grid;place-items:center;border-radius:var(--radius-sm);border:1px solid var(--border);font-size:16px;transition:border-color 0.2s;}
.notif-bell:hover{border-color:var(--accent);}
.notif-dot{position:absolute;top:6px;right:6px;width:7px;height:7px;background:var(--red);border-radius:50%;border:1.5px solid var(--bg);}
.avatar{width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,var(--accent),var(--blue));display:grid;place-items:center;font-size:13px;font-weight:700;color:#000;cursor:pointer;}

/* SIDEBAR */
.sidebar{border-right:1px solid var(--border);padding:20px 0;background:rgba(17,20,24,0.8);position:sticky;top:60px;height:calc(100vh - 60px);overflow-y:auto;}
.sidebar::-webkit-scrollbar{width:3px;}
.sidebar::-webkit-scrollbar-thumb{background:var(--border2);border-radius:99px;}
.sb-section{padding:0 14px 18px;}
.sb-label{font-family:'Space Mono',monospace;font-size:9px;letter-spacing:2px;color:var(--text-dim);text-transform:uppercase;padding:0 8px 8px;}
.nav-item{display:flex;align-items:center;gap:10px;padding:8px 12px;border-radius:var(--radius-sm);cursor:pointer;font-size:13px;font-weight:600;color:var(--text-muted);transition:all 0.15s;margin-bottom:1px;border:1px solid transparent;}
.nav-item:hover{background:var(--surface2);color:var(--text);}
.nav-item.active{background:var(--accent-dim);color:var(--accent);border-color:var(--accent-border);}
.nav-icon{font-size:15px;width:18px;text-align:center;flex-shrink:0;}
.nav-badge{margin-left:auto;font-family:'Space Mono',monospace;font-size:10px;font-weight:700;padding:1px 6px;border-radius:99px;}
.nb-red{background:var(--red);color:#fff;}
.nb-yellow{background:var(--yellow);color:#000;}
.nb-blue{background:var(--blue);color:#fff;}
.sb-divider{border:none;border-top:1px solid var(--border);margin:0 14px 18px;}
.sb-warden{margin:0 14px;padding:12px;background:var(--surface2);border:1px solid var(--border);border-radius:var(--radius);display:flex;align-items:center;gap:10px;}
.sb-warden-av{width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,var(--accent),var(--blue));display:grid;place-items:center;font-size:12px;font-weight:700;color:#000;flex-shrink:0;}
.sb-warden-name{font-size:12px;font-weight:700;line-height:1.2;}
.sb-warden-role{font-family:'Space Mono',monospace;font-size:10px;color:var(--accent);letter-spacing:0.5px;}

/* MAIN */
.main{padding:28px 32px;overflow-y:auto;min-height:calc(100vh - 60px);}
.main::-webkit-scrollbar{width:4px;}
.main::-webkit-scrollbar-thumb{background:var(--border2);border-radius:99px;}

/* PAGE */
.page{display:none;}
.page.active{display:block;animation:fadeUp 0.45s ease both;}
@keyframes fadeUp{from{opacity:0;transform:translateY(16px);}to{opacity:1;transform:translateY(0);}}

/* PAGE HEADER */
.page-hdr{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:28px;}
.page-title{font-size:26px;font-weight:800;letter-spacing:-0.5px;line-height:1;}
.page-sub{font-family:'Space Mono',monospace;font-size:11px;color:var(--text-muted);margin-top:4px;letter-spacing:0.5px;}
.live-dot{display:inline-block;width:7px;height:7px;background:var(--accent);border-radius:50%;margin-right:5px;animation:pulse 1.5s ease-in-out infinite;}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1);}50%{opacity:0.5;transform:scale(0.7);}}
.hdr-actions{display:flex;gap:10px;}

/* STAT GRID */
.stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:24px;}
.stat-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:20px;position:relative;overflow:hidden;transition:border-color 0.2s,transform 0.2s;cursor:default;animation:fadeUp 0.5s ease both;}
.stat-card:nth-child(1){animation-delay:0.05s;}
.stat-card:nth-child(2){animation-delay:0.1s;}
.stat-card:nth-child(3){animation-delay:0.15s;}
.stat-card:nth-child(4){animation-delay:0.2s;}
.stat-card:hover{transform:translateY(-2px);}
.stat-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;}
.sc-green::before{background:var(--accent);}
.sc-yellow::before{background:var(--yellow);}
.sc-blue::before{background:var(--blue);}
.sc-red::before{background:var(--red);}
.sc-green:hover{border-color:var(--accent);}
.sc-yellow:hover{border-color:var(--yellow);}
.sc-blue:hover{border-color:var(--blue);}
.sc-red:hover{border-color:var(--red);}
.stat-lbl{font-family:'Space Mono',monospace;font-size:10px;letter-spacing:1.5px;color:var(--text-muted);text-transform:uppercase;margin-bottom:10px;}
.stat-val{font-size:34px;font-weight:800;letter-spacing:-1px;line-height:1;margin-bottom:6px;}
.sc-green .stat-val{color:var(--accent);}
.sc-yellow .stat-val{color:var(--yellow);}
.sc-blue .stat-val{color:var(--blue);}
.sc-red .stat-val{color:var(--red);}
.stat-delta{font-family:'Space Mono',monospace;font-size:10px;color:var(--text-muted);}
.delta-up{color:var(--accent);}
.delta-dn{color:var(--red);}
.stat-icon{position:absolute;top:20px;right:20px;font-size:22px;opacity:0.22;}

/* PANELS */
.panel{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;margin-bottom:20px;animation:fadeUp 0.5s ease both;}
.panel-head{display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid var(--border);}
.panel-title{font-size:13px;font-weight:700;letter-spacing:0.2px;}
.panel-action{font-family:'Space Mono',monospace;font-size:10px;color:var(--accent);cursor:pointer;letter-spacing:0.5px;background:none;border:none;}
.panel-action:hover{text-decoration:underline;}

/* TABLE */
.tbl-wrap{overflow-x:auto;}
table{width:100%;border-collapse:collapse;font-size:13px;}
thead th{font-family:'Space Mono',monospace;font-size:9px;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-dim);padding:10px 20px;text-align:left;border-bottom:1px solid var(--border);}
tbody tr{border-bottom:1px solid rgba(35,40,48,0.6);transition:background 0.13s;cursor:pointer;}
tbody tr:last-child{border-bottom:none;}
tbody tr:hover{background:var(--surface2);}
td{padding:13px 20px;vertical-align:middle;}
td strong{font-weight:700;}

/* PILLS */
.pill{display:inline-flex;align-items:center;gap:5px;font-family:'Space Mono',monospace;font-size:10px;font-weight:700;padding:3px 9px;border-radius:99px;letter-spacing:0.5px;}
.pill::before{content:'';width:5px;height:5px;border-radius:50%;background:currentColor;}
.pill-pending{background:var(--yellow-dim);color:var(--yellow);border:1px solid var(--yellow-border);}
.pill-approved{background:var(--accent-dim);color:var(--accent);border:1px solid var(--accent-border);}
.pill-denied{background:var(--red-dim);color:var(--red);border:1px solid var(--red-border);}
.pill-returned{background:var(--blue-dim);color:var(--blue);border:1px solid var(--blue-border);}
.pill-open{background:var(--red-dim);color:var(--red);border:1px solid var(--red-border);}
.pill-inprog{background:var(--yellow-dim);color:var(--yellow);border:1px solid var(--yellow-border);}
.pill-closed{background:var(--accent-dim);color:var(--accent);border:1px solid var(--accent-border);}
.pill-occupied{background:var(--accent-dim);color:var(--accent);border:1px solid var(--accent-border);}
.pill-vacant{background:var(--surface3);color:var(--text-muted);border:1px solid var(--border);}
.pill-maint{background:var(--red-dim);color:var(--red);border:1px solid var(--red-border);}

/* ACTION BUTTONS */
.act-btns{display:flex;gap:6px;}
.act-btn{width:28px;height:28px;border-radius:var(--radius-sm);border:1px solid var(--border);background:none;cursor:pointer;font-size:14px;display:grid;place-items:center;transition:all 0.15s;color:var(--text-muted);}
.act-btn:hover{border-color:var(--accent);background:rgba(0,229,160,0.1);}
.act-btn.danger:hover{border-color:var(--red);background:var(--red-dim);color:var(--red);}

/* dot aliases for dashboard compatibility */
.dot-green,.nd-g{background:var(--accent);box-shadow:0 0 6px var(--accent);}
.dot-orange,.nd-r{background:var(--red);box-shadow:0 0 6px var(--red);}
.dot-blue,.nd-b{background:var(--blue);box-shadow:0 0 6px var(--blue);}
.dot-yellow,.nd-y{background:var(--yellow);box-shadow:0 0 6px var(--yellow);}

/* CONTENT GRIDS */
.grid-2{display:grid;grid-template-columns:1fr 340px;gap:20px;}
.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;}

/* NOTIF FEED */
.notif-list{}
.notif-item{display:flex;gap:12px;padding:14px 20px;border-bottom:1px solid rgba(35,40,48,0.6);transition:background 0.13s;cursor:pointer;}
.notif-item:last-child{border-bottom:none;}
.notif-item:hover{background:var(--surface2);}
.nd{width:8px;height:8px;border-radius:50%;margin-top:5px;flex-shrink:0;}
.nd-g{background:var(--accent);box-shadow:0 0 6px var(--accent);}
.nd-r{background:var(--red);box-shadow:0 0 6px var(--red);}
.nd-b{background:var(--blue);box-shadow:0 0 6px var(--blue);}
.nd-y{background:var(--yellow);box-shadow:0 0 6px var(--yellow);}
.notif-body{flex:1;}
.notif-text{font-size:12.5px;font-weight:600;line-height:1.4;}
.notif-meta{font-family:'Space Mono',monospace;font-size:10px;color:var(--text-dim);margin-top:3px;}

/* ROOM MAP */
.room-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;padding:14px 18px 18px;}
.room-cell{aspect-ratio:1;border-radius:var(--radius-sm);display:grid;place-items:center;font-family:'Space Mono',monospace;font-size:10px;font-weight:700;cursor:pointer;transition:transform 0.13s,border-color 0.13s;}
.room-cell:hover{transform:scale(1.12);}
.rc-occ{background:var(--accent-dim);border:1px solid var(--accent-border);color:var(--accent);}
.rc-vac{background:var(--surface2);border:1px solid var(--border);color:var(--text-dim);}
.rc-mnt{background:var(--red-dim);border:1px solid var(--red-border);color:var(--red);}
.room-legend{display:flex;gap:14px;padding:0 18px 14px;font-family:'Space Mono',monospace;font-size:9px;letter-spacing:1px;}

/* VOTE BARS */
.vote-list{padding:12px 20px 16px;}
.vote-item{margin-bottom:14px;}
.vote-label{display:flex;justify-content:space-between;font-size:12.5px;font-weight:600;margin-bottom:6px;}
.vote-pct{font-family:'Space Mono',monospace;font-size:11px;color:var(--text-muted);}
.vote-bar-bg{height:6px;background:var(--surface2);border-radius:99px;overflow:hidden;}
.vote-bar{height:100%;border-radius:99px;transition:width 1s ease;}
.vb-g{background:linear-gradient(90deg,var(--accent),#00b87a);}
.vb-b{background:linear-gradient(90deg,var(--blue),#2979ff);}
.vb-r{background:linear-gradient(90deg,var(--red),#e05020);}
.vb-y{background:linear-gradient(90deg,var(--yellow),#f0b800);}

/* SLA */
.sla-list{padding:10px 20px 16px;}
.sla-item{display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid rgba(35,40,48,0.5);}
.sla-item:last-child{border-bottom:none;}
.sla-ring{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;font-family:'Space Mono',monospace;font-size:9px;font-weight:700;flex-shrink:0;}
.sr-ok{background:rgba(0,229,160,0.15);border:2px solid var(--accent);color:var(--accent);}
.sr-warn{background:rgba(255,217,61,0.12);border:2px solid var(--yellow);color:var(--yellow);}
.sr-crit{background:rgba(255,107,53,0.12);border:2px solid var(--red);color:var(--red);}
.sla-info{flex:1;}
.sla-ttl{font-size:12.5px;font-weight:600;}
.sla-sub{font-family:'Space Mono',monospace;font-size:10px;color:var(--text-dim);margin-top:2px;}

/* MODAL */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.7);backdrop-filter:blur(4px);z-index:500;display:none;place-items:center;}
.modal-overlay.open{display:grid;}
.modal{background:var(--surface);border:1px solid var(--border2);border-radius:14px;width:480px;max-width:95vw;max-height:90vh;overflow-y:auto;animation:modalIn 0.25s ease;}
@keyframes modalIn{from{opacity:0;transform:scale(0.95)translateY(10px);}to{opacity:1;transform:scale(1)translateY(0);}}
.modal-head{display:flex;align-items:center;justify-content:space-between;padding:18px 22px;border-bottom:1px solid var(--border);}
.modal-title{font-size:15px;font-weight:800;}
.modal-close{background:none;border:none;color:var(--text-muted);font-size:20px;cursor:pointer;line-height:1;padding:0;}
.modal-body{padding:22px;}
.modal-footer{padding:16px 22px;border-top:1px solid var(--border);display:flex;gap:10px;justify-content:flex-end;}
.form-group{margin-bottom:16px;}
.form-label{font-family:'Space Mono',monospace;font-size:10px;letter-spacing:1px;color:var(--text-muted);text-transform:uppercase;margin-bottom:6px;display:block;}
.form-input{width:100%;background:var(--surface2);border:1px solid var(--border);border-radius:var(--radius-sm);padding:9px 12px;color:var(--text);font-family:'Syne',sans-serif;font-size:13px;outline:none;transition:border-color 0.2s;}
.form-input:focus{border-color:var(--accent);}
.form-select{width:100%;background:var(--surface2);border:1px solid var(--border);border-radius:var(--radius-sm);padding:9px 12px;color:var(--text);font-family:'Syne',sans-serif;font-size:13px;outline:none;cursor:pointer;}
.form-select:focus{border-color:var(--accent);}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;}

/* BUTTONS */
.btn{padding:9px 18px;border-radius:7px;font-family:'Space Mono',monospace;font-size:11px;font-weight:700;cursor:pointer;border:none;letter-spacing:0.5px;transition:all 0.18s;}
.btn-primary{background:var(--accent);color:#000;}
.btn-primary:hover{opacity:0.85;transform:translateY(-1px);}
.btn-ghost{background:var(--surface2);color:var(--text-muted);border:1px solid var(--border);}
.btn-ghost:hover{border-color:var(--accent);color:var(--accent);}
.btn-danger{background:var(--red-dim);color:var(--red);border:1px solid var(--red-border);}
.btn-danger:hover{background:var(--red);color:#fff;}
.btn-full{width:100%;border-radius:8px;}

/* TOAST */
.toast-container{position:fixed;bottom:24px;right:24px;z-index:600;display:flex;flex-direction:column;gap:8px;}
.toast{background:var(--surface);border:1px solid var(--border2);border-radius:var(--radius);padding:12px 18px;font-size:13px;font-weight:600;display:flex;align-items:center;gap:10px;animation:toastIn 0.3s ease;min-width:280px;}
@keyframes toastIn{from{opacity:0;transform:translateX(30px);}to{opacity:1;transform:translateX(0);}}
.toast-icon{font-size:16px;}
.toast.success{border-left:3px solid var(--accent);}
.toast.error{border-left:3px solid var(--red);}
.toast.info{border-left:3px solid var(--blue);}

/* FILTER BAR */
.filter-bar{display:flex;align-items:center;gap:10px;margin-bottom:18px;flex-wrap:wrap;}
.filter-btn{font-family:'Space Mono',monospace;font-size:10px;padding:5px 12px;border-radius:99px;border:1px solid var(--border);background:none;color:var(--text-muted);cursor:pointer;transition:all 0.15s;letter-spacing:0.5px;}
.filter-btn:hover,.filter-btn.active{border-color:var(--accent);color:var(--accent);background:var(--accent-dim);}
.filter-search{background:var(--surface2);border:1px solid var(--border);border-radius:var(--radius-sm);padding:6px 12px;color:var(--text);font-family:'Space Mono',monospace;font-size:11px;outline:none;width:200px;margin-left:auto;}
.filter-search:focus{border-color:var(--accent);}

/* ROOM PAGE */
.room-page-grid{display:grid;grid-template-columns:1fr 300px;gap:18px;}
.block-tabs{display:flex;gap:8px;margin-bottom:16px;}
.block-tab{font-family:'Space Mono',monospace;font-size:11px;padding:6px 16px;border-radius:99px;border:1px solid var(--border);background:none;color:var(--text-muted);cursor:pointer;transition:all 0.15s;}
.block-tab.active{background:var(--accent);color:#000;border-color:var(--accent);font-weight:700;}
.room-big-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;padding:18px;}
.rbc{aspect-ratio:1.3;border-radius:var(--radius-sm);display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:pointer;transition:all 0.15s;font-family:'Space Mono',monospace;}
.rbc:hover{transform:scale(1.05);}
.rbc-num{font-size:13px;font-weight:700;}
.rbc-label{font-size:9px;margin-top:2px;letter-spacing:0.5px;}
.rbc-occ{background:var(--accent-dim);border:1px solid var(--accent-border);color:var(--accent);}
.rbc-vac{background:var(--surface2);border:1px solid var(--border);color:var(--text-dim);}
.rbc-mnt{background:var(--red-dim);border:1px solid var(--red-border);color:var(--red);}
.room-stats-panel .stat-row{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid rgba(35,40,48,0.5);font-size:13px;}
.room-stats-panel .stat-row:last-child{border-bottom:none;}
.room-detail-card{padding:18px;}

/* MESS PAGE */
.mess-grid{display:grid;grid-template-columns:1fr 300px;gap:18px;}
.menu-item-card{background:var(--surface2);border:1px solid var(--border);border-radius:var(--radius);padding:14px 18px;margin-bottom:10px;display:flex;align-items:center;gap:14px;cursor:pointer;transition:border-color 0.15s;}
.menu-item-card:hover{border-color:var(--accent);}
.menu-item-card.voted{border-color:var(--accent);background:var(--accent-dim);}
.mic-rank{font-family:'Space Mono',monospace;font-size:22px;font-weight:700;color:var(--text-dim);width:32px;flex-shrink:0;}
.mic-info{flex:1;}
.mic-name{font-size:14px;font-weight:700;margin-bottom:3px;}
.mic-desc{font-size:12px;color:var(--text-muted);}
.mic-votes{font-family:'Space Mono',monospace;font-size:12px;color:var(--text-muted);margin-left:auto;}
.vote-check{width:22px;height:22px;border-radius:50%;border:2px solid var(--border);display:grid;place-items:center;flex-shrink:0;transition:all 0.2s;}
.voted .vote-check{background:var(--accent);border-color:var(--accent);color:#000;}

/* COMPLAINTS PAGE */
.complaint-card{background:var(--surface2);border:1px solid var(--border);border-radius:var(--radius);padding:16px 20px;margin-bottom:10px;cursor:pointer;transition:border-color 0.15s;}
.complaint-card:hover{border-color:var(--accent);}
.cc-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;}
.cc-id{font-family:'Space Mono',monospace;font-size:10px;color:var(--text-dim);}
.cc-title{font-size:14px;font-weight:700;margin-bottom:4px;}
.cc-meta{font-size:12px;color:var(--text-muted);display:flex;gap:12px;}
.cc-meta span{display:flex;align-items:center;gap:4px;}
.sla-bar-wrap{margin-top:10px;}
.sla-bar-bg{height:3px;background:var(--surface3);border-radius:99px;overflow:hidden;}
.sla-bar-fill{height:100%;border-radius:99px;transition:width 0.5s;}

/* VISITOR PAGE */
.visitor-log{padding:0;}

/* REPORTS PAGE */
.report-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;}
.report-card{background:var(--surface2);border:1px solid var(--border);border-radius:var(--radius);padding:20px;}
.rc-title{font-size:13px;font-weight:700;margin-bottom:16px;display:flex;justify-content:space-between;align-items:center;}
.mini-chart{height:80px;display:flex;align-items:flex-end;gap:6px;padding-top:10px;}
.mc-bar{flex:1;border-radius:3px 3px 0 0;transition:height 0.5s ease;min-width:8px;}
.mc-bar-g{background:linear-gradient(to top,var(--accent),rgba(0,229,160,0.4));}
.mc-bar-b{background:linear-gradient(to top,var(--blue),rgba(77,159,255,0.4));}
.mc-bar-r{background:linear-gradient(to top,var(--red),rgba(255,107,53,0.4));}
.mc-bar-y{background:linear-gradient(to top,var(--yellow),rgba(255,217,61,0.4));}
.chart-labels{display:flex;gap:6px;margin-top:6px;}
.chart-lbl{flex:1;font-family:'Space Mono',monospace;font-size:8px;color:var(--text-dim);text-align:center;}

/* EMPTY STATE */
.empty-state{text-align:center;padding:40px 20px;color:var(--text-muted);}
.empty-icon{font-size:36px;margin-bottom:12px;opacity:0.4;}
.empty-text{font-size:13px;}

/* SCROLLBAR */
::-webkit-scrollbar{width:5px;height:5px;}
::-webkit-scrollbar-track{background:var(--bg);}
::-webkit-scrollbar-thumb{background:var(--border2);border-radius:99px;}

/* bottom-grid alias for dashboard compatibility */
.bottom-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;}

/* RESPONSIVE */
@media(max-width:900px){
  .shell{grid-template-columns:1fr;}
  .sidebar{display:none;}
  .stat-grid{grid-template-columns:repeat(2,1fr);}
  .grid-2,.grid-3,.bottom-grid{grid-template-columns:1fr;}
  .topbar-right .tb-btn{display:none;}
}
</style>
