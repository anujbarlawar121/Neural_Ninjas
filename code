// Modal submit handlers
function submitGP() {
  const student = document.getElementById('gpStudent').value;
  const room = document.getElementById('gpRoom').value;
  const phone = document.getElementById('gpPhone').value;
  const exit = document.getElementById('gpExit').value;
  const ret = document.getElementById('gpReturn').value;
  const reason = document.getElementById('gpReason').value;
  if(!room||!phone){showToast('Please fill all fields','error');return;}
  const id = 'GP-'+(DB.gatePasses.length+330+1);
  DB.gatePasses.unshift({id,student,room,phone,exitTime:exit,returnTime:ret,date:new Date().toISOString().split('T')[0],reason,status:'pending'});
  closeModal(); showToast('Gate pass request submitted!','success');
  renderDashboard(); renderGatePasses&&renderGatePasses();
}
function submitAlloc() {
  const student = document.getElementById('allocStudent').value;
  const roomStr = document.getElementById('allocRoom').value;
  const block = roomStr[0];
  const num = roomStr.slice(2);
  const r = DB.rooms[block]&&DB.rooms[block].find(x=>x.num===num);
  if(r){ r.student=student; r.status='occupied'; r.since=new Date().toLocaleDateString('en-IN',{month:'short',year:'numeric'}); }
  closeModal(); showToast(`${student} allocated to ${roomStr}`,'success');
  renderRooms&&renderRooms();
}
function submitVisitor() {
  const name = document.getElementById('vName').value;
  const relation = document.getElementById('vRelation').value;
  const student = document.getElementById('vStudent').value;
  const room = document.getElementById('vRoom').value;
  if(!name){showToast('Please enter visitor name','error');return;}
  const id = 'V-'+(DB.visitors.length+1).toString().padStart(3,'0');
  DB.visitors.unshift({id,name,visiting:student,room,relation,inTime:new Date().toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'}),outTime:null,date:new Date().toISOString().split('T')[0],status:'active'});
  closeModal(); showToast('Visitor logged!','success');
  renderVisitors&&renderVisitors();
}
function submitSMS() {
  const to = document.getElementById('smsTo').value;
  const msg = document.getElementById('smsMsg').value;
  if(!msg.trim()){showToast('Please type a message','error');return;}
  DB.smslogs.unshift({id:'SMS-'+(DB.smslogs.length+100+1),to,phone:'BROADCAST',student:'Selected group',message:msg,time:new Date().toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'}),status:'delivered'});
  DB.smsCounter++;
  closeModal(); showToast('SMS sent to '+to,'success');
  renderSMS&&renderSMS();
}
function submitComplaint() {
  const title = document.getElementById('cTitle').value;
  const location = document.getElementById('cLocation').value;
  const priority = document.getElementById('cPriority').value;
  const room = document.getElementById('cRoom').value;
  const student = document.getElementById('cStudent').value;
  if(!title||!location){showToast('Please fill all fields','error');return;}
  const slaMap = {critical:2,high:8,medium:48,low:72};
  const id = 'C-'+(DB.complaints.length+55).toString().padStart(3,'0');
  DB.complaints.unshift({id,title,location,block:room[0]||'A',priority,status:'open',student,room,filed:new Date().toLocaleString(),slaHours:slaMap[priority],elapsed:0,assignedTo:null});
  closeModal(); showToast('Complaint filed!','success');
  renderComplaints&&renderComplaints(); renderDashboard&&renderDashboard();
}
function submitMenu() {
  const name = document.getElementById('menuName').value;
  const desc = document.getElementById('menuDesc').value;
  const emoji = document.getElementById('menuEmoji').value||'🍛';
  if(!name){showToast('Please enter dish name','error');return;}
  DB.messMenu.push({id:DB.messMenu.length+1,name,desc,emoji,votes:0});
  closeModal(); showToast(name+' added to menu!','success');
  renderMess&&renderMess();
}
function submitFeedback() {
  const student = document.getElementById('fbStudent').value;
  const meal = document.getElementById('fbMeal').value;
  const rating = 6-parseInt(document.getElementById('fbRating').value[0]);
  const comment = document.getElementById('fbComment').value;
  const id = 'FB-'+(DB.feedback.length+1).toString().padStart(3,'0');
  DB.feedback.unshift({id,student,room:'',date:new Date().toISOString().split('T')[0],meal,rating,comment,status:'pending'});
  closeModal(); showToast('Feedback submitted!','success');
  renderFeedback&&renderFeedback();
}
function resolveComplaint(id){ const c=DB.complaints.find(x=>x.id===id); if(c){c.status='closed'; closeModal(); showToast('Complaint resolved!','success'); renderComplaints&&renderComplaints(); renderDashboard&&renderDashboard();} }
function assignComplaint(id){ const c=DB.complaints.find(x=>x.id===id); if(c){c.assignedTo='Maintenance Team'; c.status='inprogress'; closeModal(); showToast('Complaint assigned','info'); renderComplaints&&renderComplaints();} }

// ==================== GLOBAL SEARCH ====================
function globalSearchFn(q) {
  if(!q) return;
  const lower = q.toLowerCase();
  const gpMatch = DB.gatePasses.find(g=>g.student.toLowerCase().includes(lower));
  const rMatch = Object.values(DB.rooms).flat().find(r=>r.student&&r.student.toLowerCase().includes(lower));
  if(gpMatch||rMatch) showToast(`Found results for "${q}" — check Gate Passes or Rooms`,'info',4000);
}

// ==================== INIT ====================
function setTopNav(btn) {
  document.querySelectorAll('.tb-btn').forEach(b => b.classList.remove('primary'));
  if(btn) btn.classList.add('primary');
}
renderDashboard();
</script>
